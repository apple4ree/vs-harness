{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "apps/desktop/src",
    "tests",
    "scripts",
    "electron.vite.config.ts",
    "playwright.config.ts"
  ]
}
